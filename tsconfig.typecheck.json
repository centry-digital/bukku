{
  // Type-checks everything tsc --build skips: test files and scripts/.
  // Run after `npm run build`, because packages resolve 'core' via its build output.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true
  },
  "include": ["packages/*/src/**/*.ts", "scripts/**/*.ts"]
}
