{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build && node esbuild.config.mjs",
    "test": "npm test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "node --test --import tsx/esm scripts/**/*.test.ts",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --build && tsc -p tsconfig.typecheck.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:parity": "tsx scripts/verify-parity.ts",
    "verify": "npm run format:check && npm run lint && npm run build && npm run typecheck && npm test && npm run verify:parity",
    "clean": "tsc --build --clean",
    "prepare": "lefthook install || true"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
